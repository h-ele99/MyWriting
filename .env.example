# Copy this file to .env and fill in your own values.
# See README.md for exactly where to find each of these.

# Supabase project settings (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Cloud OAuth Client ID for Drive backup (APIs & Services > Credentials)
# Type: OAuth client ID > Web application
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
